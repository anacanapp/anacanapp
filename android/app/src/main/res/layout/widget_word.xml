<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg_warm">
    <TextView android:id="@+id/ww_eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="10sp" android:textStyle="bold" android:textColor="#FFE8604A" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/ww_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="#FF333333" android:maxLines="5" android:ellipsize="end" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:text="🌸" />
</LinearLayout>
