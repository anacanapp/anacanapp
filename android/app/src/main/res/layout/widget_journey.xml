<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wj_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/widget_bg_warm">
    <TextView android:id="@+id/wj_emoji" android:layout_width="64dp" android:layout_height="64dp"
        android:gravity="center" android:textSize="36sp" android:background="@drawable/widget_tile_peach" android:text="🌸" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/wj_eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textStyle="bold" android:textColor="#FFB22255" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/wj_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold" android:textColor="#FF333333" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/wj_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#FF6E625A" android:maxLines="2" android:ellipsize="end" />
        <ProgressBar android:id="@+id/wj_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
            android:max="100" android:progressDrawable="@drawable/widget_progress" />
        <TextView android:id="@+id/wj_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FF9E2B2E" />
    </LinearLayout>
</LinearLayout>
