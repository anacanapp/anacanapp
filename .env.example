# Anacan — environment variables reference.
# Copy relevant values into your own `.env` (already exists in this repo with
# real Supabase keys checked in — this file just documents what each var is
# for, and specifically how to finish the Firebase Analytics (web) setup).

# ── Supabase (already configured, values live in the real .env) ──
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_ANDROID_PUSH_AUTO_REGISTER=true

# ── Firebase Analytics (web) ──────────────────────────────────────────
# A real Firebase project ("anacan-mobile", project number 296566533432)
# already exists and is fully wired up for native Auth + FCM push
# (android/app/google-services.json, ios/App/App/GoogleService-Info.plist).
# Firebase Analytics itself is the one piece left incomplete, for TWO
# independent reasons:
#
# 1) No "Web app" has ever been registered in that Firebase project.
#    Analytics on web needs its OWN apiKey/appId/measurementId, separate
#    from the Android/iOS app registrations. To get them:
#      Firebase Console -> anacan-mobile project -> Project Settings
#      -> "Your apps" -> Add app -> Web (</>) -> register e.g. app.anacan.az
#      -> copy the generated `firebaseConfig` object -> paste the 7 values
#      below (projectId/storageBucket/messagingSenderId are already known
#      project-wide constants, pre-filled here; the other 4 are unique to
#      the Web app registration and MUST come from that Console step).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=anacan-mobile
VITE_FIREBASE_STORAGE_BUCKET=anacan-mobile.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=296566533432
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
#
# 2) The last-downloaded native config snapshots explicitly show Analytics
#    OFF at the project level:
#      - ios/App/App/GoogleService-Info.plist -> IS_ANALYTICS_ENABLED = false
#      - android/app/google-services.json -> no "analytics_service" entry
#    To fix: Firebase Console -> anacan-mobile -> Project Settings ->
#    Integrations -> Google Analytics -> enable/link a GA4 property.
#    Afterwards, re-download google-services.json and
#    GoogleService-Info.plist and replace the committed files so native
#    builds pick up the change (a Console action, not a code change —
#    all Gradle/SPM wiring and FirebaseApp.configure() calls are already
#    correct and require no further edits).
#
# The app code itself (src/lib/analytics.ts) requires ZERO changes for
# either fix — it already reads these env vars and silently no-ops
# (no crash, no broken UX) whenever they're empty.
