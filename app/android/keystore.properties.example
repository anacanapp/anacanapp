# Bu faylı "keystore.properties" adı ilə köçürüb HƏQİQİ dəyərlərlə doldurun
# (app/android/keystore.properties — bu fayl .gitignore-dadır, GİT-ə HEÇ VAXT düşməməlidir).
# Capacitor layihəsinin android/keystore.properties faylı ilə eyni açarlar və eyni upload keystore:
# Flutter 60.0 Play-də mövcud tətbiqin yeniləməsi kimi yalnız eyni açarla qəbul olunur.
#
# storeFile — app/android/app/ qovluğuna nisbətən yol və ya mütləq yol
# (Codemagic mütləq yol yazır: $CM_BUILD_DIR/anacan-upload.jks):
storeFile=anacan-release-key.jks
storePassword=BURAYA_HEQIQI_STORE_PAROLU
keyAlias=BURAYA_HEQIQI_KEY_ALIAS
keyPassword=BURAYA_HEQIQI_KEY_PAROLU
