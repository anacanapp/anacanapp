<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from: android/app/src/main/res/values/styles.xml (Capacitor). The Capacitor app has no night
     variant of its splash or window colours: the launch screen and window stay cream in dark mode too. -->
<resources>
    <!-- Launch window: cream + centred mark (Capacitor's system splash look). Removed at Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window behind the Flutter UI (Capacitor AppTheme.NoActionBar windowBackground = appBackground): avoids a
         black frame between the launch window and the first Flutter frame in dark mode. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/appBackground</item>
    </style>
</resources>
