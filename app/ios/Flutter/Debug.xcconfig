#include "Generated.xcconfig"

// Native-only values (Info.plist AnacanCustomerIo* keys; AdMob when ported). Local defaults: Google's test
// AdMob app ID, Customer.io off. Codemagic overrides them through the gitignored AnacanNative.xcconfig
// written by app/tool/codemagic/apply_native_config.mjs. Never put real values in this file.
ANACAN_ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
ANACAN_CUSTOMERIO_ENABLED = false
ANACAN_CUSTOMERIO_ENVIRONMENT =
ANACAN_CUSTOMERIO_REGION =
ANACAN_CUSTOMERIO_CDP_WRITE_KEY =
// Google sign-in (public OAuth client ids; Info.plist GIDClientID / GIDServerClientID / reversed-client URL scheme).
// Written by apply_native_config.mjs from the committed ios/App/App/GoogleService-Info.plist and
// android/app/google-services.json; empty locally until it runs.
ANACAN_GOOGLE_IOS_CLIENT_ID =
ANACAN_GOOGLE_REVERSED_CLIENT_ID =
ANACAN_GOOGLE_SERVER_CLIENT_ID =
#include? "AnacanNative.xcconfig"
