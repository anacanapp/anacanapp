; METRO Simulator — Baku rush-hour tap game.
config_version=5

[application]
config/name="METRO Simulator"
config/version="1.1.0"
config/description="Bakı metrosunda hər toxunuş bir addımdır."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icons/metro.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="MetroSimulator"
boot_splash/bg_color=Color(0.035, 0.071, 0.078, 1)
boot_splash/show_image=false

[autoload]
Metro="*res://scripts/metro.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="disabled"
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver="metal"
rendering_device/driver.ios="metal"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=1024
environment/defaults/default_clear_color=Color(0.035, 0.071, 0.078, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[audio]
driver/enable_input=false

[gui]
theme/default_font_multichannel_signed_distance_field=true
